<mxfile host="app.diagrams.net"><diagram name="Overview" id="agentic-rag-intro-en"><mxGraphModel page="1" pageWidth="1600" pageHeight="1020" background="#FFFFFF" grid="0" adaptiveColors="auto"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;strokeWidth=1.5;fontColor=#202124;fontFamily=Arial;fontSize=23;fontStyle=0;spacing=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="0" y="0" width="1600" height="1020" /></mxCell><mxCell id="3" value="Agentic RAG: Retrieve in Steps, Answer from Evidence" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#202124;fontFamily=Arial;fontSize=36;fontStyle=1;spacing=14;align=left;spacing=0;fontColor=#202124;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="25" width="1540" height="55" /></mxCell><mxCell id="4" value="Epic analysis POC: a bounded ReAct loop inside a shared RAG service" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#202124;fontFamily=Arial;fontSize=24;fontStyle=0;spacing=14;align=left;spacing=0;fontColor=#555555;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="90" width="1540" height="45" /></mxCell><mxCell id="5" value="1  GATHER EVIDENCE — The coordinator drives the loop" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E7EFFB;strokeColor=#999999;strokeWidth=1.5;fontColor=#202124;fontFamily=Arial;fontSize=24;fontStyle=1;spacing=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="160" width="850" height="55" /></mxCell><mxCell id="6" value="2  BUILD ONE GROUNDED REPORT" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E7EFFB;strokeColor=#999999;strokeWidth=1.5;fontColor=#202124;fontFamily=Arial;fontSize=24;fontStyle=1;spacing=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="930" y="160" width="640" height="55" /></mxCel