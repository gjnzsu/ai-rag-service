e="&lt;b&gt;Published snapshot&lt;/b&gt;&lt;br&gt;Neo4j · read only&lt;br&gt;One-hop BLOCKS" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F1F1;strokeColor=#999999;strokeWidth=1.5;fontColor=#202124;fontFamily=Arial;fontSize=23;fontStyle=0;spacing=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="590" y="650" width="290" height="110" /></mxCell><mxCell id="19" value="Read" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#747474;strokeWidth=2;fontFamily=Arial;fontSize=20;fontColor=#333333;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="15" target="18"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="20" value="Coordinator owns both stages.&lt;br&gt;When the loop stops, prepare the report." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#202124;fontFamily=Arial;fontSize=22;fontStyle=1;spacing=14;align=left;spacing=0;fontColor=#202124;" vertex="1" parent="1"><mxGeometry as="geometry" x="950" y="245" width="600" height="65" /></mxCell><mxCell id="21" value="&lt;b&gt;Prepare · Python coordinator&lt;/b&gt;&lt;br&gt;Deduplicate evidence · assign IDs&lt;br&gt;Verify findings + coverage" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E4EFDF;strokeColor=#999999;strokeWidth=1.5;fontColor=#202124;fontFamily=Arial;fontSize=23;fontStyle=0;spacing=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="950" y="320" width="600" height="125" /></mxCell><mxCell id="22" value="&lt;b&gt;Generate · One final LLM call&lt;/b&gt;&lt;br&gt;Summarize facts and limitations&lt;br&gt;Validate citation IDs in code" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E7E2F1;strokeColor=#999999;strokeWidth=1.5;fontColor=#202124;fontFamily=Arial;fontSize=23;fontStyle=0;spacing=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="950" y="505" width="600" height="120" /></mxCell><mxCell id="23" value="&lt;b&gt;Report to the caller&lt;/b&gt;&lt;br&gt;Facts + findings + cited answer&lt;br&gt;Coverage: complete or partial" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F1F1;strokeColor=#999999;strokeWidth=1.5;fontColor=#202124;fontFamily=Arial;fontSize=23;fontStyle=0;spacing=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="950" y="685" width="600" height="125" /></mxCell><mxCell id="24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#747474;strokeWidth=2;fontFamily=Arial;fontSize=20;fontColor=#333333;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="21" target="22"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#747474;strokeWidth=2;fontFamily=Arial;fontSize=20;fontColor=#333333;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="22" target="23"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="26" value="&lt;b&gt;Bounded exploration&lt;/b&gt;&lt;br&gt;Up to 3 tool calls, including the initial read.&lt;br&gt;Later decisions reuse earlier observations." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF3CE;strokeColor=#999999;strokeWidth=1.5;fontColor=#202124;fontFamily=Arial;fontSize=22;fontStyle=0;spacing=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="855" width="850" height="110" /></mxCell><mxCell id="27" value="&lt;b&gt;Coverage comes from code.&lt;/b&gt;&lt;br&gt;Merge evidence first. Assign E1, E2… once.&lt;br&gt;Generate one report after retrieval stops." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF3CE;strokeColor=#999999;strokeWidth=1.5;fontColor=#202124;fontFamily=Arial;fontSize=22;fontStyle=0;spacing=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="930" y="855" width="640" height="110" /></mxCell><mxCell id="28" value="ai-rag-service  /  Optional POC · Fixed project + snapshot · Story status, Bugs and recorded blockers" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#202124;fontFamily=Arial;fontSize=18;fontStyle=0;spacing=14;align=left;spacing=0;fontColor=#666666;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="983" width="1540" height="25" /></mxCell></root></mxGraphModel></diagram></mxfile>