<mxfile host="app.diagrams.net"><diagram name="协调层与调用关系" id="coordinator"><mxGraphModel page="1" pageWidth="1620" pageHeight="1180" grid="1" gridSize="10"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Agentic RAG：由协调层驱动检索与报告" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fillColor=none;strokeColor=none;fontSize=30;fontStyle=1;align=left;"><mxGeometry x="30" y="15" width="1550" height="60" as="geometry" /></mxCell><mxCell id="service" value="ai-rag-service" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fillColor=#f8fafc;strokeColor=#94a3b8;swimlane;startSize=40;align=left;spacingLeft=20;fontStyle=1;"><mxGeometry x="30" y="190" width="1180" height="940" as="geometry" /></mxCell><mxCell id="coord" value="协调层 · Coordinator" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fillColor=#eff6ff;strokeColor=#2563eb;swimlane;startSize=48;align=left;spacingLeft=20;fontSize=24;fontStyle=1;strokeWidth=2;"><mxGeometry x="60" y="355" width="590" height="740" as="geometry" /></mxCell><mxCell id="caller" value="&lt;b&gt;调用方 / 其他 Agent&lt;/b&gt;&lt;br&gt;项目 + Epic + 问题 + 可选快照" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fillColor=#e2e8f0;strokeColor=#64748b;"><mxGeometry x="90" y="95" width="530" height="70" as="geometry" /></mxCell><mxCell id="api" value="&lt;b&gt;POST /agentic/query&lt;/b&gt; · 输入校验 / 项目白名单 / 固定快照" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fillColor=#dbeafe;strokeColor=#2563eb;"><mxGeometry x="90" y="250" width="1060" height="60" as="geometry" /></mxCell><mxCell id="initial" value="&lt;b&gt;① 强制初始读取&lt;/b&gt;&lt;br&gt;协调层调用 get_epic_backlog" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fillColor=#dbeafe;strokeColor=#2563eb;"><mxGeometry x="90" y="430" width="530" height="90" as="geometry" /></mxCell><mxCell id="loop" value="&lt;b&gt;② 有界 ReAct 循环&lt;/b&gt;&lt;br&gt;模型决策 → 调用工具 → 观察 → 再决策&lt;br&gt;持续更新请求内证据与覆盖账本" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fillColor=#dbeafe;strokeColor=#2563eb;"><mxGeometry x="90" y="580" width="530" height="120" as="geometry" /></mxCell><mxCell id="finalize" value="&lt;b&gt;③ 协调层结束检索并准备报告&lt;/b&gt;&lt;br&gt;合并证据 / 统一引用编号 / 核验 findings&lt;br&gt;build_report → 调用 ReportGenerator 一次" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fillColor=#dbeafe;strokeColor=#2563eb;"><mxGeometry x="90" y="775" width="530" height="100" as="geometry" /></mxCell><mxCell id="return" value="&lt;b&gt;④ 协调层返回结果&lt;/b&gt;&lt;br&gt;facts / findings / coverage / answer&lt;br&gt;生成失败时仍保留已核验事实" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fillColor=#dbeafe;strokeColor=#2563eb;"><mxGeometry x="90" y="945" width="530" height="90" as="geometry" /></mxCell><mxCell id="tools" value="&lt;b&gt;EpicTools → GraphService&lt;/b&gt;&lt;br&gt;分页清单 / Story 统计&lt;br&gt;单跳 BLOCKS 查询" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fillColor=#dcfce7;strokeColor=#16a34a;"><mxGeometry x="810" y="430" width="340" height="90" as="geometry" /></mxCell><mxCell id="decider" value="&lt;b&gt;ModelDecider&lt;/b&gt;&lt;br&gt;问题 + 观察 + 剩余预算&lt;br&gt;校验 lookup / finish 结构化动作" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fillColor=#ede9fe;strokeColor=#7c3aed;"><mxGeometry x="810" y="590" width="340" height="100" as="geometry" /></mxCell><mxCell id="generator" value="&lt;b&gt;ReportGenerator&lt;/b&gt;&lt;br&gt;基于合并证据生成一次回答&lt;br&gt;调用 CitationValidator 校验引用" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fillColor=#ede9fe;strokeColor=#7c3aed;"><mxGeometry x="810" y="775" width="340" height="100" as="geometry" /></mxCell><mxCell id="note" value="请求状态由 EpicTools 保存、协调层管理。&lt;br&gt;GraphService 只返回查询数据；&lt;br&gt;最终汇总与生成由协调层驱动。" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fillColor=none;strokeColor=none;fontSize=16;align=left;"><mxGeometry x="790" y="945" width="380" height="100" as="geometry" /></mxCell><mxCell id="providers" value="存储与模型提供方" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fillColor=none;strokeColor=none;fontStyle=1;fontSize=20;"><mxGeometry x="1310" y="345" width="270" height="55" as="geometry" /></mxCell><mxCell id="graph" value="&lt;b&gt;Neo4j + 已发布快照&lt;/b&gt;&lt;br&gt;固定 site / project / snapshot&lt;br&gt;只读访问" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fillColor=#fef3c7;strokeColor=#d97706;"><mxGeometry x="1310" y="430" width="270" height="90" as="geometry" /></mxCell><mxCell id="decisionmodel" value="&lt;b&gt;OpenAI 决策模型&lt;/b&gt;&lt;br&gt;严格 JSON Schema&lt;br&gt;选择动作" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fillColor=#ede9fe;strokeColor=#7c3aed;"><mxGeometry x="1310" y="590" width="270" height="100" as="geometry" /></mxCell><mxCell id="answermodel" value="&lt;b&gt;OpenAI 生成模型&lt;/b&gt;&lt;br&gt;组织事实与限制&lt;br&gt;返回文字 + 引用 ID" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fillColor=#ede9fe;strokeColor=#7c3aed;"><mxGeometry x="1310" y="775" width="270" height="100" as="geometry" /></mxCell><mxCell id="a" source="caller" target="api" value="" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#475569;fontSize=15;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.25;entryY=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b" source="api" target="initial" value="" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#475569;fontSize=15;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c" source="initial" target="loop" value="" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0