<mxfile host="app.diagrams.net"><diagram name="Coordinator and call ownership" id="coordinator"><mxGraphModel page="1" pageWidth="1620" pageHeight="1180" grid="1" gridSize="10"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Agentic RAG: The Coordinator Drives Retrieval and Reporting" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fillColor=none;strokeColor=none;fontSize=30;fontStyle=1;align=left;"><mxGeometry x="30" y="15" width="1550" height="60" as="geometry" /></mxCell><mxCell id="service" value="ai-rag-service" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fillColor=#f8fafc;strokeColor=#94a3b8;swimlane;startSize=40;align=left;spacingLeft=20;fontStyle=1;"><mxGeometry x="30" y="190" width="1180" height="940" as="geometry" /></mxCell><mxCell id="coord" value="Coordinator" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fillColor=#eff6ff;strokeColor=#2563eb;swimlane;startSize=48;align=left;spacingLeft=20;fontSize=24;fontStyle=1;strokeWidth=2;"><mxGeometry x="60" y="355" width="590" height="740" as="geometry" /></mxCell><mxCell id="caller" value="&lt;b&gt;Applications / Other Agents&lt;/b&gt;&lt;br&gt;Project + Epic + Question + Optional snapshot" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fillColor=#e2e8f0;strokeColor=#64748b;"><mxGeometry x="90" y="95" width="530" height="70" as="geometry" /></mxCell><mxCell id="api" value="&lt;b&gt;POST /agentic/query&lt;/b&gt; · Validate input / Allowlisted project / Pinned snapshot" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fillColor=#dbeafe;strokeColor=#2563eb;"><mxGeometry x="90" y="250" width="1060" height="60" as="geometry" /></mxCell><mxCell id="initial" value="&lt;b&gt;1. Mandatory Initial Read&lt;/b&gt;&lt;br&gt;Coordinator calls get_epic_backlog" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fillColor=#dbeafe;strokeColor=#